{
  "name": "fyul/wiremock-phpunit",
  "type": "library",
  "description": "Wiremock library for easier integration with PHPUnit.",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "phpunit/phpunit": "^10.0|^11.0",
    "ramsey/uuid": "^4.7",
    "wiremock-php/wiremock-php": "^2.0"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "WireMock\\Phpunit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "guzzlehttp/guzzle": "^7.0",
    "phpstan/phpstan": "^1.10"
  }
}
